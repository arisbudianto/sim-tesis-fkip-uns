{
    "name": "uns/sim-tesis",
    "type": "project",
    "description": "Sistem Informasi Manajemen Siklus Lengkap Tahapan Tesis (SIM-TESIS) S2 FKIP UNS",
    "keywords": ["laravel", "sim-tesis", "fkip-uns", "thesis-management"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "barryvdh/laravel-dompdf": "^3.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "setasign/fpdi-fpdf": "^2.3"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "test": "phpunit"
    }
}
