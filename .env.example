APP_NAME=SIM-TESIS-UNS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# APP_URL & PROFIL ENVIRONMENT
# ---------------------------------------------------------------------------
# LOKAL (pengembangan):
#   APP_URL=http://localhost:8000        (atau http://localhost jika pakai Sail/Docker)
#   APP_ENV=local
#   APP_DEBUG=true
#
# PRODUKSI (pgv.speakverse.id):
#   APP_URL=https://pgv.speakverse.id
#   APP_ENV=production
#   APP_DEBUG=false                      <-- WAJIB false, jangan expose stack trace
#   SESSION_SECURE_COOKIE=true           <-- WAJIB true di atas HTTPS
#
# Seluruh generator link (notifikasi WA, unduhan naskah PDF, QR verifikasi
# dokumen di Modul 9 & 10) WAJIB memanggil config('app.url') / helper url(),
# BUKAN string domain hardcode, supaya otomatis benar di kedua profil ini.
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# DATABASE (MySQL — lihat docker-compose.yml untuk service lokal)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_tesis
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# SESSION (Session-based Auth — lihat Modul 3)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# ^ set true di produksi (HTTPS wajib di pgv.speakverse.id)

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# EMAIL (opsional — notifikasi cadangan selain WhatsApp)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@pgv.speakverse.id"
MAIL_FROM_NAME="${APP_NAME}"

# Channel notifikasi aktif: email | whatsapp | email,whatsapp
NOTIFIKASI_CHANNELS=email,whatsapp

# ---------------------------------------------------------------------------
# WHATSAPP GATEWAY (Modul 9 — App\Domain\Notifikasi\Services\WhatsAppNotifierService)
# ---------------------------------------------------------------------------
# Kosongkan kalau belum ada gateway — notifikasi otomatis dilewati (log-only),
# tidak akan menggagalkan alur akademik utama (plotting jadwal, dsb).
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
